# Copy to .env.local and fill in as needed (.env.local is gitignored by
# create-next-app's default .gitignore already).

# Same Firebase project as nool-apps / nool-core - one Identity Provider
# for the whole platform. Web API keys are meant to be public (they
# identify the project, not authorize access - see Firebase's own docs).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBCmswnUmBMVqzN4c7WDuHFhSzQ04Rbv5A
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nool-test-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nool-test-app
NEXT_PUBLIC_FIREBASE_APP_ID=1:50959568481:web:93faa23bcb4f083b27e420
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nool-test-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=50959568481

# nool-core's NGINX gateway - see nool-core/docs/DEVELOPMENT.md.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
